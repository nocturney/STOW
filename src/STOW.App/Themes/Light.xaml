<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#F5FAFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SidebarColor">#FBFDFF</Color>
    <Color x:Key="SurfaceElevatedColor">#EEF5FC</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#52637D</Color>
    <Color x:Key="BorderColor">#D7E5F4</Color>
    <Color x:Key="ControlBorderColor">#9AACBF</Color>
    <Color x:Key="AccentBlueColor">#3B82F6</Color>
    <Color x:Key="AccentBlueStrongColor">#1677F8</Color>
    <Color x:Key="AccentTealColor">#1D7F70</Color>
    <Color x:Key="AccentBlueSoftColor">#E2EFFF</Color>
    <Color x:Key="AccentTealSoftColor">#DDF5F0</Color>
    <Color x:Key="AccentAmberColor">#9A6420</Color>
    <Color x:Key="AccentAmberSoftColor">#F7EAD7</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="SelectionColor">#D9EBFF</Color>
    <Color x:Key="SelectionForegroundColor">#0F172A</Color>
    <Color x:Key="HoverColor">#E8F3FF</Color>
    <Color x:Key="HoverForegroundColor">#0F172A</Color>
    <Color x:Key="MutedColor">#66758C</Color>
    <Color x:Key="NavForegroundColor">#1D3553</Color>
    <Color x:Key="NavIconColor">#263F5F</Color>
    <Color x:Key="NavHoverIconColor">#1677F8</Color>
    <Color x:Key="NavHoverColor">#EDF6FF</Color>
    <Color x:Key="NavHoverBorderColor">#CBE3FB</Color>
    <Color x:Key="NavSelectionColor">#E4F1FF</Color>
    <Color x:Key="NavSelectionHoverColor">#DCEBFF</Color>
    <Color x:Key="NavSelectionForegroundColor">#0B2748</Color>
    <Color x:Key="NavSelectedIconColor">#1677F8</Color>

    <LinearGradientBrush x:Key="ShellBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCFEFF" Offset="0" />
        <GradientStop Color="#F7FBFF" Offset="0.48" />
        <GradientStop Color="#ECF5FF" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="ShellAmbientBlueBrush">
        <GradientStop Color="#343B82F6" Offset="0" />
        <GradientStop Color="#123B82F6" Offset="0.58" />
        <GradientStop Color="#003B82F6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ShellAmbientTealBrush">
        <GradientStop Color="#1814B8A6" Offset="0" />
        <GradientStop Color="#0014B8A6" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F7FBFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBFDFF" Offset="0" />
        <GradientStop Color="#F7FBFF" Offset="0.58" />
        <GradientStop Color="#EDF6FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentBlueStrongBrush" Color="{StaticResource AccentBlueStrongColor}" />
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="{StaticResource AccentBlueSoftColor}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="AccentTealSoftBrush" Color="{StaticResource AccentTealSoftColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentAmberSoftBrush" Color="{StaticResource AccentAmberSoftColor}" />
    <LinearGradientBrush x:Key="PrimaryActionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1479FF" Offset="0" />
        <GradientStop Color="#278CFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="{StaticResource SelectionForegroundColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="HoverForegroundBrush" Color="{StaticResource HoverForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="{StaticResource NavForegroundColor}" />
    <SolidColorBrush x:Key="NavIconBrush" Color="{StaticResource NavIconColor}" />
    <SolidColorBrush x:Key="NavHoverIconBrush" Color="{StaticResource NavHoverIconColor}" />
    <LinearGradientBrush x:Key="NavHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F4F9FF" Offset="0" />
        <GradientStop Color="#EAF4FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavHoverBorderBrush" Color="{StaticResource NavHoverBorderColor}" />
    <LinearGradientBrush x:Key="NavSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EAF4FF" Offset="0" />
        <GradientStop Color="#DDEEFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSelectionHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E2F0FF" Offset="0" />
        <GradientStop Color="#D4E8FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavSelectionForegroundBrush" Color="{StaticResource NavSelectionForegroundColor}" />
    <SolidColorBrush x:Key="NavSelectedIconBrush" Color="{StaticResource NavSelectedIconColor}" />
    <DropShadowEffect x:Key="NavHoverEffect"
                      BlurRadius="14"
                      ShadowDepth="0"
                      Opacity="0.14"
                      Color="#2387F4" />
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="22"
                      ShadowDepth="2"
                      Opacity="0.13"
                      Color="#4A78A8" />
</ResourceDictionary>
