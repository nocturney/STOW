<UserControl x:Class="STOW.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="STOW" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="A calmer desktop starts here." Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock x:Name="VersionText" Text="Version  —" Margin="0,0,24,0" />
                            <TextBlock x:Name="BuildText" Text="Build  —" Margin="0,0,24,0" />
                            <TextBlock x:Name="ChannelText" Text="Channel  —" />
                        </StackPanel>
                        <TextBlock x:Name="LastCheckText" Text="Last update check  Never" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="What's New" Margin="0,0,10,0"
                                Click="WhatsNew_Click" />
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource PrimaryButton}"
                                Content="Check for Updates" Click="CheckUpdates_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="More information" Style="{StaticResource SectionTitle}" Margin="0,8,0,10" />
            <UniformGrid Columns="2" Rows="3">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                    <StackPanel><TextBlock Text="Privacy" FontWeight="SemiBold"/><TextBlock Text="How STOW handles local data" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel><TextBlock Text="License" FontWeight="SemiBold"/><TextBlock Text="MIT license and terms" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,10">
                    <StackPanel><TextBlock Text="Open-source notices" FontWeight="SemiBold"/><TextBlock Text="Third-party components and licenses" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel><TextBlock Text="Diagnostics" FontWeight="SemiBold"/><TextBlock Text="Build, environment and troubleshooting details" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Support" FontWeight="SemiBold"/><TextBlock Text="Help and issue reporting" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel><TextBlock Text="GitHub &amp; Releases" FontWeight="SemiBold"/><TextBlock Text="Source, releases and release notes" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
