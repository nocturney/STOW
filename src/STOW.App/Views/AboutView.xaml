<UserControl x:Class="STOW.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="STOW" FontSize="{DynamicResource FontSize24}" FontWeight="SemiBold" />
                        <TextBlock Text="A calmer desktop starts here." Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <WrapPanel Margin="0,18,0,0">
                            <TextBlock x:Name="VersionText" Text="Version  —" Margin="0,0,24,8" />
                            <TextBlock x:Name="BuildText" Text="Build  —" Margin="0,0,24,8" />
                            <TextBlock x:Name="ChannelText" Text="Channel  —" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock x:Name="LastCheckText" Text="Last update check  Never" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize12}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right">
                        <Button x:Name="WhatsNewButton" Style="{StaticResource SecondaryButton}"
                                Content="Release Notes" Margin="0,0,10,8"
                                Click="WhatsNew_Click" />
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource PrimaryButton}"
                                Content="Check for Updates" Margin="0,0,0,8"
                                Click="CheckUpdates_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <TextBlock Text="More information" Style="{StaticResource SectionTitle}" Margin="0,8,0,10" />
            <UniformGrid Columns="2" Rows="3">
                <Button Margin="0,0,10,10" Padding="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="Privacy"
                        HorizontalContentAlignment="Stretch" Click="Privacy_Click">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Privacy" FontWeight="SemiBold" />
                            <TextBlock Text="Local data, network access and update privacy"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button Margin="0,0,0,10" Padding="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="License"
                        HorizontalContentAlignment="Stretch" Click="License_Click">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="License" FontWeight="SemiBold" />
                            <TextBlock Text="MIT license and project terms"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button Margin="0,0,10,10" Padding="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="Open-source notices"
                        HorizontalContentAlignment="Stretch" Click="Notices_Click">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Open-source notices" FontWeight="SemiBold" />
                            <TextBlock Text=".NET runtime notices and compatibility-baseline disclosures"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button Margin="0,0,0,10" Padding="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="Diagnostics"
                        HorizontalContentAlignment="Stretch" Click="Diagnostics_Click">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                            <TextBlock Text="Copy a local build and environment summary"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button Margin="0,0,10,0" Padding="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="Support"
                        HorizontalContentAlignment="Stretch" Click="Support_Click">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Support" FontWeight="SemiBold" />
                            <TextBlock Text="Issues, bug reports and security guidance"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Button>

                <Button Padding="0" BorderThickness="0" Background="Transparent"
                        AutomationProperties.Name="GitHub &amp; Releases"
                        HorizontalContentAlignment="Stretch" Click="GitHubReleases_Click">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="GitHub &amp; Releases" FontWeight="SemiBold" />
                            <TextBlock Text="Source code, releases and release notes"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
