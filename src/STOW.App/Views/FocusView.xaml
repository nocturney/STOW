<UserControl x:Class="STOW.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.98*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1.5"
                        Padding="18"
                        MinHeight="292">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.22"
                                          Color="#1683FF" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current session"
                                       FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSize16}" />
                            <Border x:Name="SessionStatusChip"
                                    Grid.Column="1"
                                    Style="{StaticResource StatusChip}"
                                    Background="{DynamicResource AccentTealSoftBrush}"
                                    BorderBrush="{DynamicResource AccentTealBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentTealBrush}"
                                             Margin="0,0,6,0" />
                                    <TextBlock x:Name="SessionStatusText"
                                               Text="Ready to start"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,12,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="166" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Find your focus"
                                           FontFamily="{DynamicResource StowDisplayFont}"
                                           FontSize="{DynamicResource FontSize30}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Stow distractions for this session while keeping the apps that matter visible."
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Image Grid.Column="1"
                                   Width="166"
                                   Height="142"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Source="/STOW;component/Assets/STOWHero.png"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   Focusable="False" />
                        </Grid>

                        <Button x:Name="FocusActionButton"
                                Grid.Row="2"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="FocusAction_Click">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Path Width="15"
                                      Height="16"
                                      Margin="0,0,9,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform"
                                      Data="M2,1 L14,8 L2,15 Z" />
                                <TextBlock Text="Start focus mode"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        Padding="16"
                        MinHeight="292">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Quick presets"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Instant setups"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30"
                                        CornerRadius="7"
                                        Background="{DynamicResource AccentBlueSoftBrush}">
                                    <Path Width="17" Height="17"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentBlueStrongBrush}"
                                          StrokeThickness="1.7"
                                          Data="M2,4 H16 V14 H2 Z M0,16 H18" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Deep work"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Maximum focus, minimal apps"
                                               FontSize="{DynamicResource FontSize11}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="DeepWorkButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Use"
                                        MinHeight="34"
                                        Padding="10,3"
                                        Click="DeepWork_Click" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30"
                                        CornerRadius="7"
                                        Background="{DynamicResource AccentTealSoftBrush}">
                                    <Path Width="17" Height="17"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentTealBrush}"
                                          StrokeThickness="1.7"
                                          Data="M2,9 C5,4 11,4 16,9 C11,14 5,14 2,9 M7,9 A2,2 0 1 1 6.99,9" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Keep all visible"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Focus without stowing apps"
                                               FontSize="{DynamicResource FontSize11}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="KeepAllButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Use"
                                        MinHeight="34"
                                        Padding="10,3"
                                        Click="KeepAll_Click" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30"
                                        CornerRadius="7"
                                        Background="{DynamicResource AccentAmberSoftBrush}">
                                    <Path Width="17" Height="17"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentAmberBrush}"
                                          StrokeThickness="1.7"
                                          Data="M3,3 H15 V15 H3 Z M6,3 V8 H12 V3 M6,12 H12" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Custom"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Save your current selection"
                                               FontSize="{DynamicResource FontSize11}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="SavePresetButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Save"
                                        MinHeight="34"
                                        Padding="10,3"
                                        Click="SavePreset_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource CardBorder}"
                        Padding="16"
                        MinHeight="292">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Focus schedule"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="SchedulesSummaryText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <TextBlock x:Name="ScheduleStatusText"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   FontSize="{DynamicResource FontSize11}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="NoSchedulesText"
                                   Text="No Focus schedules yet."
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <ItemsControl x:Name="ScheduleList"
                                      AutomationProperties.Name="Focus schedules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Status}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="{DynamicResource FontSize11}"
                                                               Foreground="{DynamicResource AccentTealBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      AutomationProperties.Name="Enable Focus schedule"
                                                      Tag="{Binding Id}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      IsEnabled="{Binding CanManage}"
                                                      Click="ScheduleEnabled_Click"
                                                      VerticalAlignment="Center"
                                                      Margin="8,0,8,0" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="Edit"
                                                    AutomationProperties.Name="Edit Focus schedule"
                                                    Tag="{Binding Id}"
                                                    IsEnabled="{Binding CanManage}"
                                                    MinHeight="32"
                                                    Padding="9,2"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Click="EditSchedule_Click" />
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="×"
                                                    AutomationProperties.Name="Delete Focus schedule"
                                                    ToolTip="Delete schedule"
                                                    Width="34"
                                                    MinHeight="32"
                                                    Padding="0"
                                                    Tag="{Binding Id}"
                                                    IsEnabled="{Binding CanManage}"
                                                    VerticalAlignment="Center"
                                                    Click="DeleteSchedule_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button x:Name="AddScheduleButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="+  Add focus block"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Click="AddSchedule_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="FocusStatusBanner"
                    Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="FocusStatusText"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.42*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.78*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        MinHeight="280">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Apps during Focus"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Choose which managed apps stay visible during this session."
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="ManagedAppsSummaryText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize11}" />
                        </Grid>

                        <TextBlock x:Name="NoManagedAppsText"
                                   Text="No enabled managed apps are available. Add and enable apps from Apps first."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,4" />

                        <ItemsControl x:Name="FocusAppsList"
                                      AutomationProperties.Name="Apps during Focus">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRowBorder}"
                                            Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessName}"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Content="Keep visible"
                                                      Tag="{Binding Key}"
                                                      IsChecked="{Binding KeepVisible, Mode=OneWay}"
                                                      IsEnabled="{Binding CanEdit}"
                                                      Click="KeepVisible_Click"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border x:Name="SavedPresetsCard"
                            Style="{StaticResource CardBorder}"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Saved presets"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SavedPresetsSummaryText"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSize11}" />
                            </Grid>
                            <TextBlock x:Name="NoSavedPresetsText"
                                       Text="No saved Focus presets yet."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,2" />
                            <ItemsControl x:Name="SavedPresetsList"
                                          AutomationProperties.Name="Saved Focus presets">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowBorder}"
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}"
                                                               Margin="0,2,0,0"
                                                               FontSize="{DynamicResource FontSize11}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Content="Use"
                                                            Tag="{Binding Id}"
                                                            IsEnabled="{Binding CanUse}"
                                                            MinHeight="32"
                                                            Padding="9,2"
                                                            Margin="0,0,6,0"
                                                            Click="UsePreset_Click" />
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Content="×"
                                                            AutomationProperties.Name="Delete Focus preset"
                                                            Tag="{Binding Id}"
                                                            Width="34"
                                                            MinHeight="32"
                                                            Padding="0"
                                                            Click="DeletePreset_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Session"
                                       Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stowed by Focus"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="StowedCountText"
                                           Grid.Column="1"
                                           Text="0"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kept visible"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="VisibleCountText"
                                           Grid.Column="1"
                                           Text="0"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Margin="0,14,0,0"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36"
                            CornerRadius="8"
                            Background="{DynamicResource SelectionBrush}">
                        <Path Width="20" Height="20"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentTealBrush}"
                              StrokeThickness="1.7"
                              Data="M3,6 L10,2 L17,6 L10,10 Z M3,10 L10,14 L17,10 M3,14 L10,18 L17,14" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="A more intentional desktop."
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Hide what distracts you. Keep what moves you forward."
                                   FontSize="{DynamicResource FontSize11}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="Less noise."
                               Margin="18,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Grid.Column="3"
                            Background="{DynamicResource BorderBrush}" />
                    <TextBlock Grid.Column="4"
                               Text="More focus."
                               Margin="18,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Grid.Column="5"
                            Background="{DynamicResource BorderBrush}" />
                    <TextBlock Grid.Column="6"
                               Text="A brighter day."
                               Margin="18,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>