<Window x:Class="STOW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="STOW"
        Width="1440" Height="860"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource CanvasBrush}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource ShellBackdropBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="228" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="3"
                  IsHitTestVisible="False"
                  ClipToBounds="True">
                <Ellipse Width="640"
                         Height="430"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-170,-170,0"
                         Fill="{DynamicResource ShellAmbientBlueBrush}" />
                <Ellipse Width="500"
                         Height="340"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="160,0,0,-170"
                         Fill="{DynamicResource ShellAmbientTealBrush}" />
            </Grid>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    CornerRadius="12,0,0,12">
                <Grid Margin="14,0,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="118" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="10,22,8,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="56" Height="56"
                               Source="/STOW;component/Assets/STOW.png"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Focusable="False" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="5,0,0,0">
                            <TextBlock Text="STOW"
                                       FontFamily="{DynamicResource StowDisplayFont}"
                                       FontSize="{DynamicResource FontSize26}"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="AppsNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Apps"
                                CommandParameter="Apps"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M2.5,2.5 Q2.5,2 3,2 H7.5 Q8,2 8,2.5 V7.5 Q8,8 7.5,8 H3 Q2.5,8 2.5,7.5 Z M12,2.5 Q12,2 12.5,2 H17 Q17.5,2 17.5,2.5 V7.5 Q17.5,8 17,8 H12.5 Q12,8 12,7.5 Z M2.5,12.5 Q2.5,12 3,12 H7.5 Q8,12 8,12.5 V17.5 Q8,18 7.5,18 H3 Q2.5,18 2.5,17.5 Z M12,12.5 Q12,12 12.5,12 H17 Q17.5,12 17.5,12.5 V17.5 Q17.5,18 17,18 H12.5 Q12,18 12,17.5 Z" />
                                <AccessText Text="_Apps" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RulesNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Rules"
                                CommandParameter="Rules"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M3,5 Q3,4 4,4 H16 Q17,4 17,5 V17 Q17,18 16,18 H4 Q3,18 3,17 Z M3,8 H17 M7,2 V6 M13,2 V6" />
                                <AccessText Text="_Rules" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FocusNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Focus"
                                CommandParameter="Focus"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M10,2 A8,8 0 1 1 9.99,2 M10,5 A5,5 0 1 1 9.99,5 M10,8 A2,2 0 1 1 9.99,8 M10,10 L16.5,3.5 M13.5,3.5 H16.5 V6.5" />
                                <AccessText Text="_Focus" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="InsightsNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Insights"
                                CommandParameter="Insights"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M3,18 V13 Q3,12 4,12 H5 Q6,12 6,13 V18 M8.5,18 V9 Q8.5,8 9.5,8 H10.5 Q11.5,8 11.5,9 V18 M14,18 V5 Q14,4 15,4 H16 Q17,4 17,5 V18 M2,18 H18" />
                                <AccessText Text="_Insights" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Settings"
                                CommandParameter="Settings"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M8.3,2.2 L8.8,1 H11.2 L11.7,2.2 L13.3,2.9 L14.5,2.4 L16.1,4 L15.6,5.2 L16.3,6.8 L17.6,7.3 V9.7 L16.3,10.2 L15.6,11.8 L16.1,13 L14.5,14.6 L13.3,14.1 L11.7,14.8 L11.2,16 H8.8 L8.3,14.8 L6.7,14.1 L5.5,14.6 L3.9,13 L4.4,11.8 L3.7,10.2 L2.4,9.7 V7.3 L3.7,6.8 L4.4,5.2 L3.9,4 L5.5,2.4 L6.7,2.9 Z M10,6 A2,2 0 1 1 9.99,6" />
                                <AccessText Text="_Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="14,0,10,14">
                        <TextBlock Text="☾"
                                   FontSize="{DynamicResource FontSize22}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Stay focused."
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="You've got this."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button x:Name="AboutNavButton"
                            Grid.Row="4"
                            Style="{StaticResource NavButton}"
                            AutomationProperties.Name="About STOW"
                            CommandParameter="About"
                            Click="Navigate_Click"
                            Margin="8,2,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 M10,9 V15 M10,6.5 V6.6" />
                            <AccessText Text="A_bout" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ShellCaptionButton}"
                                AutomationProperties.Name="Minimize"
                                Click="Minimize_Click">
                            <Path Width="10" Height="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Data="M0,0 H10" />
                        </Button>
                        <Button Style="{StaticResource ShellCaptionButton}"
                                AutomationProperties.Name="Maximize or restore"
                                Click="MaximizeRestore_Click">
                            <Path Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                        </Button>
                        <Button Style="{StaticResource ShellCloseButton}"
                                AutomationProperties.Name="Close"
                                Click="CloseButton_Click">
                            <Path Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M0,0 L10,10 M10,0 L0,10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="28,5,24,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ShellSearchBox"
                             Style="{StaticResource SearchBox}"
                             Tag="Search apps, rules, or settings..."
                             AutomationProperties.Name="Search STOW"
                             Width="480"
                             MaxWidth="520"
                             HorizontalAlignment="Left"
                             TextChanged="ShellSearchBox_TextChanged"
                             KeyDown="ShellSearchBox_KeyDown" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}"
                                CommandParameter="Focus"
                                Click="Navigate_Click"
                                AutomationProperties.Name="Open Focus mode"
                                MinWidth="144"
                                MinHeight="40"
                                Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16"
                                      Margin="0,0,8,0"
                                      Stroke="{DynamicResource AccentTealBrush}"
                                      StrokeThickness="1.7"
                                      Stretch="Uniform"
                                      Data="M2,9 C4,3 10,1 14,2 C14,8 11,13 5,14 M3,13 C6,10 9,8 13,6" />
                                <TextBlock Text="Focus mode"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="28,8,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PageIconBadge"
                                Width="52"
                                Height="52"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="Collapsed">
                            <Path x:Name="PageIconPath"
                                  Width="43"
                                  Height="43"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBlueStrongBrush}"
                                  StrokeThickness="2.1"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Effect="{DynamicResource NavHoverEffect}"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 M10,5 A5,5 0 1 1 9.99,5 M10,8 A2,2 0 1 1 9.99,8 M10,10 L16.5,3.5 M13.5,3.5 H16.5 V6.5" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PageTitleText"
                                       Text="Apps"
                                       Style="{StaticResource PageTitle}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="PageSubtitleText"
                                       Text="Keep what matters in view. Stow the rest."
                                       Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="20,0,0,2">
                        <Rectangle Width="52"
                                   Height="1"
                                   Fill="{DynamicResource ControlBorderBrush}"
                                   Margin="0,0,16,6" />
                        <TextBlock Text="F O C U S   L I V E S   H E R E"
                                   FontSize="{DynamicResource FontSize11}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost"
                                Grid.Row="4"
                                Margin="28,0,30,28" />
            </Grid>
        </Grid>
    </Border>
</Window>