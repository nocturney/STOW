<UserControl x:Class="STOW.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,14">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="340"
                         HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged" />
                <Button x:Name="NewRuleButton" Style="{StaticResource PrimaryButton}" Content="New rule"
                        HorizontalAlignment="Right" Click="NewRule_Click" />
            </Grid>

            <Border x:Name="RulesStatusBanner" Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="RulesStatusText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="AllRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="All rules"
                        Tag="All"
                        Margin="0,0,8,0"
                        Click="RulesFilter_Click" />
                <Button x:Name="AppRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="App rules"
                        Tag="Minimize"
                        Margin="0,0,8,0"
                        Click="RulesFilter_Click" />
                <Button x:Name="FocusRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Focus rules"
                        Tag="Focus"
                        Margin="0,0,8,0"
                        Click="RulesFilter_Click" />
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Startup rules"
                        IsEnabled="False"
                        ToolTip="Startup rule triggers are not enabled yet." />
            </StackPanel>

            <Border x:Name="EmptyRulesCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="10,20">
                    <TextBlock x:Name="EmptyRulesTitleText"
                               Text="No rules yet"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyRulesBodyText"
                               Text="Create an app or Focus rule for a managed application."
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxWidth="460" />
                </StackPanel>
            </Border>

            <ListBox x:Name="RulesList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="RulesList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTealBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
            <Grid>
                <StackPanel x:Name="EditorPlaceholder" VerticalAlignment="Center">
                    <TextBlock Text="Select a rule" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose an existing rule or create a new one."
                               Margin="0,6,0,0" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="EditorTitleText" Text="Rule" FontSize="19" FontWeight="SemiBold" />
                        <CheckBox x:Name="EnabledCheckBox" Content="Enabled" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="RuleNameTextBox" Style="{StaticResource SearchBox}" Margin="0,6,0,14" />

                    <TextBlock Text="App" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="AppComboBox" Height="38" DisplayMemberPath="Name" Margin="0,6,0,14" />

                    <TextBlock Text="When" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="TriggerComboBox"
                              Height="38"
                              SelectedIndex="0"
                              Margin="0,6,0,14">
                        <ComboBoxItem Content="The app is minimized" />
                        <ComboBoxItem Content="Focus starts" />
                    </ComboBox>

                    <TextBlock Text="Action" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ActionComboBox" Height="38" SelectedIndex="0" Margin="0,6,0,14">
                        <ComboBoxItem Content="Stow in system tray" />
                        <ComboBoxItem Content="Keep visible on taskbar" />
                    </ComboBox>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Priority" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PriorityValueText" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider x:Name="PrioritySlider" Minimum="0" Maximum="100" Value="50"
                            ValueChanged="PrioritySlider_ValueChanged" Margin="0,4,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DeleteRuleButton" Style="{StaticResource SecondaryButton}" Content="Delete"
                                Click="DeleteRule_Click" Margin="0,0,8,0" />
                        <Button x:Name="DuplicateRuleButton" Style="{StaticResource SecondaryButton}" Content="Duplicate"
                                Click="DuplicateRule_Click" Margin="0,0,8,0" />
                        <Button x:Name="SaveRuleButton" Style="{StaticResource PrimaryButton}" Content="Save"
                                Click="SaveRule_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
