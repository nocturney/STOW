<Window x:Class="STOW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STOW"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid Margin="14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="10,4,10,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>                    <Control Width="42" Height="42"
                             Template="{StaticResource StowMarkTemplate}"
                             IsHitTestVisible="False"
                             Focusable="False" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="STOW" FontSize="{DynamicResource FontSize24}"
                                   FontWeight="Bold" />
                        <TextBlock Text="A calmer desktop." Margin="0,1,0,0"
                                   FontSize="{DynamicResource FontSize11}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Button x:Name="AppsNavButton" Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Apps"
                            Tag="Apps" Click="Navigate_Click"
                            Background="{DynamicResource SelectionBrush}"
                            Foreground="{DynamicResource SelectionForegroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" />
                            <AccessText Text="_Apps" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Rules"
                            Tag="Rules" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M3,5 H17 V18 H3 Z M3,9 H17 M7,2 V7 M13,2 V7" />
                            <AccessText Text="_Rules" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Focus"
                            Tag="Focus" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 M10,6 A4,4 0 1 1 9.99,6 M10,9 A1,1 0 1 1 9.99,9" />
                            <AccessText Text="_Focus" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Insights"
                            Tag="Insights" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M3,18 V12 H6 V18 M8.5,18 V8 H11.5 V18 M14,18 V4 H17 V18" />
                            <AccessText Text="_Insights" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Settings"
                            Tag="Settings" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M10,6 A4,4 0 1 1 9.99,6 M10,1 V4 M10,16 V19 M1,10 H4 M16,10 H19 M3.6,3.6 L5.7,5.7 M14.3,14.3 L16.4,16.4 M16.4,3.6 L14.3,5.7 M5.7,14.3 L3.6,16.4" />
                            <AccessText Text="_Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="14,0,10,14">
                    <TextBlock Text="☾" FontSize="{DynamicResource FontSize22}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Stay focused." Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="You've got this." Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Row="4" Style="{StaticResource NavButton}"
                        AutomationProperties.Name="About STOW"
                        Tag="About" Click="Navigate_Click" Margin="8,2,8,2">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconPath}"
                              Data="M10,2 A8,8 0 1 1 9.99,2 M10,9 V15 M10,6.5 V6.6" />
                        <AccessText Text="A_bout" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Column="2" Margin="30,22,34,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitleText"
                               Text="Apps"
                               Style="{StaticResource PageTitle}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="PageSubtitleText"
                               Text="Choose what STOW keeps quietly out of your way."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Tag="Focus"
                        Click="Navigate_Click"
                        AutomationProperties.Name="Open Focus mode"
                        MinWidth="142"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◉" Margin="0,0,8,0"
                                   Foreground="{DynamicResource AccentTealBrush}" />
                        <TextBlock Text="Focus mode" />
                    </StackPanel>
                </Button>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>