<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#071523</Color>
    <Color x:Key="SurfaceColor">#0B1D30</Color>
    <Color x:Key="SidebarColor">#081829</Color>
    <Color x:Key="SurfaceElevatedColor">#102942</Color>
    <Color x:Key="TextPrimaryColor">#F3F7FC</Color>
    <Color x:Key="TextSecondaryColor">#A9BED5</Color>
    <Color x:Key="BorderColor">#24415E</Color>
    <Color x:Key="ControlBorderColor">#50718F</Color>
    <Color x:Key="AccentBlueColor">#3B82F6</Color>
    <Color x:Key="AccentBlueStrongColor">#1683FF</Color>
    <Color x:Key="AccentTealColor">#14B8A6</Color>
    <Color x:Key="AccentBlueSoftColor">#123B6A</Color>
    <Color x:Key="AccentTealSoftColor">#103F3B</Color>
    <Color x:Key="AccentAmberColor">#E2A558</Color>
    <Color x:Key="AccentAmberSoftColor">#4A3724</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="SelectionColor">#153A68</Color>
    <Color x:Key="SelectionForegroundColor">#E5E7EB</Color>
    <Color x:Key="HoverColor">#162942</Color>
    <Color x:Key="HoverForegroundColor">#E5E7EB</Color>
    <Color x:Key="MutedColor">#8190A5</Color>
    <Color x:Key="NavForegroundColor">#D3DEEA</Color>
    <Color x:Key="NavIconColor">#B4C6D8</Color>
    <Color x:Key="NavHoverIconColor">#47A8FF</Color>
    <Color x:Key="NavHoverColor">#102B47</Color>
    <Color x:Key="NavHoverBorderColor">#28547E</Color>
    <Color x:Key="NavSelectionColor">#123D70</Color>
    <Color x:Key="NavSelectionHoverColor">#164A83</Color>
    <Color x:Key="NavSelectionForegroundColor">#F3F7FC</Color>
    <Color x:Key="NavSelectedIconColor">#47A8FF</Color>

    <LinearGradientBrush x:Key="ShellBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#071523" Offset="0" />
        <GradientStop Color="#081A2C" Offset="0.55" />
        <GradientStop Color="#06111E" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="ShellAmbientBlueBrush">
        <GradientStop Color="#343B82F6" Offset="0" />
        <GradientStop Color="#123B82F6" Offset="0.58" />
        <GradientStop Color="#003B82F6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ShellAmbientTealBrush">
        <GradientStop Color="#1614B8A6" Offset="0" />
        <GradientStop Color="#0014B8A6" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D2238" Offset="0" />
        <GradientStop Color="#091A2C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#081829" Offset="0" />
        <GradientStop Color="#081A2D" Offset="0.58" />
        <GradientStop Color="#0A2238" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentBlueStrongBrush" Color="{StaticResource AccentBlueStrongColor}" />
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="{StaticResource AccentBlueSoftColor}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="AccentTealSoftBrush" Color="{StaticResource AccentTealSoftColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentAmberSoftBrush" Color="{StaticResource AccentAmberSoftColor}" />
    <LinearGradientBrush x:Key="PrimaryActionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#137CFF" Offset="0" />
        <GradientStop Color="#2198FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="{StaticResource SelectionForegroundColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="HoverForegroundBrush" Color="{StaticResource HoverForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="NavForegroundBrush" Color="{StaticResource NavForegroundColor}" />
    <SolidColorBrush x:Key="NavIconBrush" Color="{StaticResource NavIconColor}" />
    <SolidColorBrush x:Key="NavHoverIconBrush" Color="{StaticResource NavHoverIconColor}" />
    <LinearGradientBrush x:Key="NavHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E2944" Offset="0" />
        <GradientStop Color="#123858" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavHoverBorderBrush" Color="{StaticResource NavHoverBorderColor}" />
    <LinearGradientBrush x:Key="NavSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#123966" Offset="0" />
        <GradientStop Color="#194D83" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSelectionHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#164476" Offset="0" />
        <GradientStop Color="#1C5896" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavSelectionForegroundBrush" Color="{StaticResource NavSelectionForegroundColor}" />
    <SolidColorBrush x:Key="NavSelectedIconBrush" Color="{StaticResource NavSelectedIconColor}" />
    <DropShadowEffect x:Key="NavHoverEffect"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Opacity="0.22"
                      Color="#238CFF" />
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="24"
                      ShadowDepth="2"
                      Opacity="0.30"
                      Color="#020A14" />
</ResourceDictionary>
