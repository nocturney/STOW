<UserControl x:Class="STOW.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                         MaxWidth="480" HorizontalAlignment="Left" Width="420"
                         TextChanged="SearchBox_TextChanged" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add app"
                        IsEnabled="False" ToolTip="Available after the engine migration is connected."
                        Margin="12,0,0,0" />
            </Grid>

            <Grid Margin="0,0,0,10">
                <TextBlock Text="Managed apps" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Apps STOW is currently managing" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            </Grid>

            <Border x:Name="NoManagedApps" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="10,20">
                    <TextBlock Text="No managed apps yet" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Add support will be enabled when the v0.3.3 runtime adapter is connected."
                               Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="520" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ManagedAppsList" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding ProcessName}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Configured" IsChecked="{Binding Enabled}" IsEnabled="False" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,10">
                <TextBlock Text="Available apps" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="AvailableSummaryText" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            </Grid>

            <Border x:Name="NoAvailableApps" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <TextBlock Text="No user-facing desktop apps match this search."
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </Border>

            <ItemsControl x:Name="AvailableAppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding WindowTitle}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProcessName}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add"
                                        IsEnabled="False" VerticalAlignment="Center"
                                        ToolTip="Available after the engine migration is connected." />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
