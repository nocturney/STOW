<UserControl x:Class="STOW.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,14">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="340"
                         HorizontalAlignment="Left"
                         AutomationProperties.Name="Search rules"
                         AutomationProperties.HelpText="Filter saved rules."
                         TextChanged="SearchBox_TextChanged" />
                <Button x:Name="NewRuleButton" Style="{StaticResource PrimaryButton}" Content="New rule"
                        HorizontalAlignment="Right" Click="NewRule_Click" />
            </Grid>

            <Border x:Name="RulesStatusBanner" Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="RulesStatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="AllRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="All rules"
                        Tag="All"
                        Margin="0,0,8,0"
                        Click="RulesFilter_Click" />
                <Button x:Name="AppRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="App rules"
                        Tag="Minimize"
                        Margin="0,0,8,0"
                        Click="RulesFilter_Click" />
                <Button x:Name="FocusRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Focus rules"
                        Tag="Focus"
                        Margin="0,0,8,0"
                        Click="RulesFilter_Click" />
                <Button x:Name="StartupRulesFilterButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Startup rules"
                        Tag="Startup"
                        Click="RulesFilter_Click"
                        ToolTip="Rules applied when a managed app process is first observed." />
            </StackPanel>

            <Border x:Name="EmptyRulesCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" Margin="10,20">
                    <TextBlock x:Name="EmptyRulesTitleText"
                               Text="No rules yet"
                               FontSize="{DynamicResource FontSize16}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyRulesBodyText"
                               Text="Create an app, Focus or Startup rule for a managed application."
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               MaxWidth="460" />
                </StackPanel>
            </Border>

            <ListBox x:Name="RulesList"
                     AutomationProperties.Name="Saved rules"
                     BorderThickness="0" Background="Transparent"
                     SelectionChanged="RulesList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,10">
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource FontSize12}" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Type}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,12,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentTealBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
            <Grid>
                <StackPanel x:Name="EditorPlaceholder" VerticalAlignment="Center">
                    <TextBlock Text="Select a rule" FontSize="{DynamicResource FontSize18}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose an existing rule or create a new one."
                               Margin="0,6,0,0" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="EditorTitleText" Text="Rule" FontSize="{DynamicResource FontSize19}" FontWeight="SemiBold" />
                        <CheckBox x:Name="EnabledCheckBox" Content="Enabled" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="RuleNameLabel" Text="Name" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="RuleNameTextBox" Style="{StaticResource SearchBox}"
                             AutomationProperties.LabeledBy="{Binding ElementName=RuleNameLabel}"
                             Margin="0,6,0,14" />

                    <TextBlock x:Name="RuleAppLabel" Text="App" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="AppComboBox"
                              MinHeight="44"
                              DisplayMemberPath="Name"
                              AutomationProperties.LabeledBy="{Binding ElementName=RuleAppLabel}"
                              Margin="0,6,0,14" />

                    <TextBlock x:Name="RuleTriggerLabel" Text="When" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="TriggerComboBox"
                              MinHeight="44"
                              AutomationProperties.LabeledBy="{Binding ElementName=RuleTriggerLabel}"
                              SelectedIndex="0"
                              Margin="0,6,0,14">
                        <ComboBoxItem Content="The app is minimized" />
                        <ComboBoxItem Content="Focus starts" />
                        <ComboBoxItem Content="The app starts" />
                    </ComboBox>

                    <TextBlock x:Name="RuleActionLabel" Text="Action" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ActionComboBox"
                              MinHeight="44"
                              AutomationProperties.LabeledBy="{Binding ElementName=RuleActionLabel}"
                              SelectedIndex="0"
                              Margin="0,6,0,14">
                        <ComboBoxItem Content="Stow in system tray" />
                        <ComboBoxItem Content="Keep visible on taskbar" />
                    </ComboBox>

                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="RulePriorityLabel" Text="Priority" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="PriorityValueText" HorizontalAlignment="Right"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <Slider x:Name="PrioritySlider" Minimum="0" Maximum="100" Value="50"
                            AutomationProperties.LabeledBy="{Binding ElementName=RulePriorityLabel}"
                            AutomationProperties.HelpText="Higher-priority matching rules win."
                            ValueChanged="PrioritySlider_ValueChanged" Margin="0,4,0,20" />

                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="DeleteRuleButton" Style="{StaticResource SecondaryButton}" Content="Delete"
                                Click="DeleteRule_Click" Margin="0,0,8,8" />
                        <Button x:Name="DuplicateRuleButton" Style="{StaticResource SecondaryButton}" Content="Duplicate"
                                Click="DuplicateRule_Click" Margin="0,0,8,8" />
                        <Button x:Name="SaveRuleButton" Style="{StaticResource PrimaryButton}" Content="Save"
                                Click="SaveRule_Click" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
