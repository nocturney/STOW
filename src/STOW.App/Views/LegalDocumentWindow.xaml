<Window x:Class="STOW.App.Views.LegalDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="STOWLegalDocumentWindow"
        Title="STOW"
        Width="800" Height="680" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="DocumentTitleText"
                       FontSize="{DynamicResource FontSize24}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="DocumentSubtitleText"
                       Margin="0,6,0,0"
                       Text="This copy is bundled with STOW for offline access."
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="6">
            <TextBox x:Name="DocumentTextBox"
                     AutomationProperties.Name="Bundled legal document"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas, Segoe UI"
                     FontSize="{DynamicResource FontSize13}"
                     Padding="10" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    Content="Copy all"
                    Margin="0,0,10,0"
                    Click="CopyAll_Click" />
            <Button x:Name="OpenLegalFolderButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Open legal folder"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"
                    Click="OpenLegalFolder_Click" />
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Close"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
