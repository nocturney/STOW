<UserControl x:Class="STOW.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Find your focus" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Temporarily stow distractions without changing your permanent app setup."
                                   Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Start Focus" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Quick presets" Style="{StaticResource SectionTitle}" Margin="0,2,0,10" />
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Deep work" FontWeight="SemiBold"/><TextBlock Text="Stow communication and media apps" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Meeting" FontWeight="SemiBold"/><TextBlock Text="Keep collaboration visible, stow the rest" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel><TextBlock Text="Create preset" FontWeight="SemiBold"/><TextBlock Text="Save a desktop state for later" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Focus schedule" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="No scheduled sessions" Margin="0,8,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Add schedule" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Apps during focus" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Stowed" FontWeight="SemiBold"/><TextBlock Text="Discord · Media apps" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Visible" FontWeight="SemiBold"/><TextBlock Text="Editor · Browser" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Distraction level" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="24%" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,2" Foreground="{DynamicResource AccentTealBrush}" />
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="24" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Recommended for you" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Try Deep work when communication apps start competing for attention."
                                       Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
