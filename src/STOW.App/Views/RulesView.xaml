<UserControl x:Class="STOW.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Grid Margin="0,0,0,14">
                <TextBox Style="{StaticResource SearchBox}" Width="340" HorizontalAlignment="Left" Text="Search rules" />
                <Button Style="{StaticResource PrimaryButton}" Content="New rule" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource SecondaryButton}" Content="All rules" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="App rules" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Focus rules" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="Startup rules" />
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <StackPanel>
                    <Grid Background="{DynamicResource SurfaceElevatedBrush}" Margin="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Rule" FontWeight="SemiBold" Margin="16,10" />
                        <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" Margin="10" />
                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Margin="10" />
                    </Grid>
                    <Grid Margin="1,0,1,1" Background="{DynamicResource SelectionBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="16,13">
                            <TextBlock Text="Hide Discord" FontWeight="SemiBold" />
                            <TextBlock Text="When minimized, stow Discord in the tray" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="App rule" VerticalAlignment="Center" Margin="10" />
                        <TextBlock Grid.Column="2" Text="Enabled" VerticalAlignment="Center" Margin="10" Foreground="{DynamicResource AccentTealBrush}" />
                    </Grid>
                    <Grid Margin="1,0,1,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="16,13">
                            <TextBlock Text="Quiet startup" FontWeight="SemiBold" />
                            <TextBlock Text="Start selected apps without desktop clutter" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Startup" VerticalAlignment="Center" Margin="10" />
                        <TextBlock Grid.Column="2" Text="Enabled" VerticalAlignment="Center" Margin="10" Foreground="{DynamicResource AccentTealBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Hide Discord" FontSize="19" FontWeight="SemiBold" />
                    <Border Style="{StaticResource StatusChip}" HorizontalAlignment="Right">
                        <TextBlock Text="Enabled" Foreground="{DynamicResource AccentTealBrush}" />
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,18">
                    <TextBlock Text="Details" FontWeight="SemiBold" Margin="0,0,18,0" Foreground="{DynamicResource AccentBlueBrush}" />
                    <TextBlock Text="Conditions" Margin="0,0,18,0" />
                    <TextBlock Text="Actions" />
                </StackPanel>
                <TextBlock Text="App" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Style="{StaticResource SearchBox}" Text="Discord" Margin="0,6,0,14" />
                <TextBlock Text="When" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox Height="38" SelectedIndex="0" Margin="0,6,0,14">
                    <ComboBoxItem Content="The app is minimized" />
                    <ComboBoxItem Content="Focus starts" />
                </ComboBox>
                <TextBlock Text="Action" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox Height="38" SelectedIndex="0" Margin="0,6,0,14">
                    <ComboBoxItem Content="Stow in system tray" />
                    <ComboBoxItem Content="Keep visible" />
                </ComboBox>
                <TextBlock Text="Priority" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Slider Minimum="0" Maximum="100" Value="50" Margin="0,8,0,20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="Delete" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Duplicate" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
