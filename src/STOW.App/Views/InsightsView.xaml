<UserControl x:Class="STOW.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource AccentTealSoftBrush}"
                    BorderThickness="1.5"
                    Margin="0,0,0,14"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34"
                            CornerRadius="8"
                            Background="{DynamicResource SelectionBrush}">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentTealBrush}"
                              StrokeThickness="1.7"
                              Data="M10,2 L16,5 V10 C16,14 13,17 10,18 C7,17 4,14 4,10 V5 Z" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="Private by design"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Insights are calculated from local STOW activity and stay on this PC."
                                   Margin="0,2,0,0"
                                   FontSize="{DynamicResource FontSize11}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Style="{StaticResource StatusChip}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7"
                                     Fill="{DynamicResource AccentTealBrush}"
                                     Margin="0,0,6,0" />
                            <TextBlock Text="Local only"
                                       Foreground="{DynamicResource AccentTealBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="InsightsStatusBanner"
                    Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                <TextBlock x:Name="InsightsStatusText"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <UniformGrid Columns="3"
                         Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                CornerRadius="9"
                                Background="{DynamicResource SelectionBrush}">
                            <Path Width="18" Height="18"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBlueStrongBrush}"
                                  StrokeThickness="1.7"
                                  Data="M3,4 H17 V16 H3 Z M6,7 H14 M6,10 H12" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Stows · last 7 days"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="StowsCountText"
                                       Text="0"
                                       FontSize="{DynamicResource FontSize30}"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                CornerRadius="9"
                                Background="{DynamicResource SelectionBrush}">
                            <Path Width="18" Height="18"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentTealBrush}"
                                  StrokeThickness="1.7"
                                  Data="M4,10 H16 M10,4 L16,10 L10,16" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Restores · last 7 days"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="RestoresCountText"
                                       Text="0"
                                       FontSize="{DynamicResource FontSize30}"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                CornerRadius="9"
                                Background="{DynamicResource SelectionBrush}">
                            <Path Width="18" Height="18"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBlueStrongBrush}"
                                  StrokeThickness="1.7"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 M10,6 A4,4 0 1 1 9.99,6 M10,9 A1,1 0 1 1 9.99,9" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Focus sessions · last 7 days"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="FocusCountText"
                                       Text="0"
                                       FontSize="{DynamicResource FontSize30}"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border x:Name="EmptyHistoryCard"
                    Style="{StaticResource CardBorder}"
                    MinHeight="310">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20,34">
                    <Border Width="54" Height="54"
                            CornerRadius="12"
                            Background="{DynamicResource SelectionBrush}"
                            Margin="0,0,0,14">
                        <Path Width="26" Height="26"
                              Stretch="Uniform"
                              Stroke="{DynamicResource AccentBlueStrongBrush}"
                              StrokeThickness="1.7"
                              Data="M3,18 V12 H6 V18 M8.5,18 V8 H11.5 V18 M14,18 V4 H17 V18" />
                    </Border>
                    <TextBlock Text="No local history yet"
                               FontSize="{DynamicResource FontSize18}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Once STOW stows, restores, or runs Focus sessions, useful patterns will appear here."
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="540"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="No telemetry or cloud account is required."
                               Margin="0,5,0,0"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="HistoryContent"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ActivityHistoryColumn"
                            Grid.Row="0"
                            Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}"
                            Margin="0,0,0,14"
                            MinHeight="250">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="7-day activity"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="HistoryRangeText"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="Local history"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="10"
                                    Padding="14"
                                    MinHeight="150">
                                <ItemsControl x:Name="ActivityChartList"
                                              AutomationProperties.Name="Seven day activity chart"
                                              AutomationProperties.HelpText="Local STOW activity totals for each of the last seven days."
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="105" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Width="24"
                                                        Height="{Binding Height}"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Center"
                                                        CornerRadius="7,7,2,2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#1683FF" Offset="0" />
                                                            <GradientStop Color="#3B82F6" Offset="0.58" />
                                                            <GradientStop Color="#14B8A6" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Count}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,5,0,0"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Label}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36"
                                    CornerRadius="9"
                                    Background="{DynamicResource SelectionBrush}">
                                <Path Width="18" Height="18"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource AccentTealBrush}"
                                      StrokeThickness="1.7"
                                      Data="M3,6 L10,2 L17,6 L10,10 Z M3,10 L10,14 L17,10 M3,14 L10,18 L17,14" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Most stowed app"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="MostStowedAppText"
                                           Text="—"
                                           Margin="0,3,0,0"
                                           FontSize="{DynamicResource FontSize20}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="MostStowedCountText"
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border x:Name="RecentActivityCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        MinHeight="360">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recent activity"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="RecentCountText"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       HorizontalAlignment="Right"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize11}" />
                        </Grid>
                        <ItemsControl x:Name="RecentActivityList"
                                      AutomationProperties.Name="Recent activity">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRowBorder}"
                                            Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Margin="1,5,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Stow">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentBlueStrongBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Restore">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentTealBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Focus">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentAmberBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeText}"
                                                       Margin="0,0,14,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource FontSize11}"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Stored only in %APPDATA%\STOW\activity.jsonl"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="{DynamicResource FontSize11}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>