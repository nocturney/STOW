<Window x:Class="STOW.App.Views.FocusPresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Focus preset"
        Width="420"
        MinHeight="210"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Border Margin="16" Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="Save current Focus setup"
                       FontSize="{DynamicResource FontSize18}"
                       FontWeight="SemiBold" />
            <TextBlock Text="Give this Keep visible selection a reusable name."
                       Margin="0,6,0,14"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="NameTextBox"
                     Style="{StaticResource SearchBox}"
                     AutomationProperties.Name="Preset name"
                     AutomationProperties.HelpText="Name this reusable Focus preset."
                     MaxLength="64" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Save preset"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
