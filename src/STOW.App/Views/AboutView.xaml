<UserControl x:Class="STOW.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.92*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        MinHeight="250">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Width="88"
                               Height="88"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Source="/STOW;component/Assets/STOW.png"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Focusable="False" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="STOW"
                                       FontSize="{DynamicResource FontSize30}"
                                       FontWeight="Bold" />
                            <TextBlock Text="A calmer desktop starts here."
                                       Margin="0,3,0,0"
                                       FontSize="{DynamicResource FontSize14}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Version"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="VersionText"
                                           Grid.Column="1"
                                           Text="—" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Build"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="BuildText"
                                           Grid.Column="1"
                                           Text="—" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Channel"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="ChannelText"
                                           Grid.Column="1"
                                           Text="—" />
                            </Grid>

                            <TextBlock x:Name="LastCheckText"
                                       Text="Last update check  Never"
                                       Margin="0,14,0,12"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <WrapPanel>
                                <Button x:Name="CheckUpdatesButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Check for updates"
                                        Margin="0,0,10,8"
                                        Click="CheckUpdates_Click" />
                                <Button x:Name="WhatsNewButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="View what's new"
                                        Margin="0,0,0,8"
                                        Click="WhatsNew_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        MinHeight="250">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="A  M O R E  I N T E N T I O N A L"
                                       FontSize="{DynamicResource FontSize11}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="D E S K T O P"
                                       Margin="0,2,0,0"
                                       FontSize="{DynamicResource FontSize11}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Less noise. More focus."
                                       Margin="0,10,0,0"
                                       FontSize="{DynamicResource FontSize18}"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <Control Width="300"
                                 Height="186"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,34,-10,-4"
                                 Template="{StaticResource StowHeroTemplate}"
                                 IsHitTestVisible="False"
                                 Focusable="False" />
                    </Grid>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.98*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="WhatsNewCard"
                        Grid.Column="0"
                        Style="{StaticResource CardBorder}"
                        Padding="18"
                        MinHeight="310">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="What's new"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="0.4.0-preview.7"
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="Release notes  →"
                                    Click="WhatsNew_Click" />
                        </Grid>

                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentTealBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,6,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="Accessibility is now a first-class STOW product layer."
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentTealBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,6,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="100%, 125%, 150% and 200% in-app text scaling with stronger contrast controls."
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentTealBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,6,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="Windows Contrast Themes, clearer keyboard focus and improved screen-reader semantics."
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource AccentTealBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,6,0,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="Apps, Rules and About layouts hardened for large text without clipping."
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="InformationCard"
                        Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        Padding="14"
                        MinHeight="310">
                    <StackPanel>
                        <TextBlock Text="More information"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="4,2,4,10" />

                        <Button x:Name="PrivacyButton"
                                AutomationProperties.Name="Privacy"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="Privacy_Click">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="9"
                                    Padding="10"
                                    Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="{DynamicResource SelectionBrush}">
                                        <Path Width="17" Height="17"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource AccentTealBrush}"
                                              StrokeThickness="1.7"
                                              Data="M10,2 L16,5 V10 C16,14 13,17 10,18 C7,17 4,14 4,10 V5 Z" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Privacy"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="How your local data and updates are handled"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="↗"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="LicenseButton"
                                AutomationProperties.Name="License"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="License_Click">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="9"
                                    Padding="10"
                                    Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="{DynamicResource SelectionBrush}">
                                        <Path Width="17" Height="17"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBlueStrongBrush}"
                                              StrokeThickness="1.7"
                                              Data="M4,2 H12 L16,6 V18 H4 Z M12,2 V6 H16" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="License"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="View the MIT license and project terms"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="↗"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="NoticesButton"
                                AutomationProperties.Name="Open-source notices"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="Notices_Click">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="9"
                                    Padding="10"
                                    Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="{DynamicResource SelectionBrush}">
                                        <TextBlock Text="&lt;/&gt;"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBlueStrongBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Open-source notices"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Third-party notices, credits and compatibility disclosures"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="↗"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Button>

                        <Button x:Name="DiagnosticsButton"
                                AutomationProperties.Name="Diagnostics"
                                HorizontalContentAlignment="Stretch"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="Diagnostics_Click">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="9"
                                    Padding="10"
                                    Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="{DynamicResource SelectionBrush}">
                                        <Path Width="18" Height="18"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource AccentTealBrush}"
                                              StrokeThickness="1.7"
                                              Data="M1,10 H5 L7,4 L11,16 L13,10 H19" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Diagnostics"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Copy a local build and environment summary"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="↗"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SupportButton"
                                    Grid.Column="0"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="Support"
                                    Click="Support_Click" />

                            <Button x:Name="GitHubButton"
                                    Grid.Column="2"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="GitHub &amp; Releases"
                                    Click="GitHubReleases_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>