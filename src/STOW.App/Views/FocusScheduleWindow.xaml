<Window x:Class="STOW.App.Views.FocusScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus schedule"
        Width="520"
        Height="610"
        MinWidth="520"
        MinHeight="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}">
    <Border Margin="16" Style="{StaticResource CardBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeadingText"
                           Text="Add Focus schedule"
                           FontSize="{DynamicResource FontSize18}"
                           FontWeight="SemiBold" />
                <TextBlock Text="Run a saved Focus preset on a recurring local-time schedule."
                           Margin="0,6,0,16"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock x:Name="ScheduleNameLabel" Text="Name" FontWeight="SemiBold" />
                <TextBox x:Name="NameTextBox"
                         Style="{StaticResource SearchBox}"
                         AutomationProperties.LabeledBy="{Binding ElementName=ScheduleNameLabel}"
                         MaxLength="64"
                         Margin="0,6,0,14" />

                <TextBlock x:Name="SchedulePresetLabel" Text="Saved preset" FontWeight="SemiBold" />
                <ComboBox x:Name="PresetComboBox"
                          Margin="0,6,0,14"
                          MinHeight="44"
                          Padding="8,4"
                          AutomationProperties.LabeledBy="{Binding ElementName=SchedulePresetLabel}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id" />
                <TextBlock Text="Days" FontWeight="SemiBold" />
                <UniformGrid Columns="4" Margin="0,8,0,14">
                    <CheckBox x:Name="MondayCheckBox" Content="Mon" Margin="0,0,8,8" />
                    <CheckBox x:Name="TuesdayCheckBox" Content="Tue" Margin="0,0,8,8" />
                    <CheckBox x:Name="WednesdayCheckBox" Content="Wed" Margin="0,0,8,8" />
                    <CheckBox x:Name="ThursdayCheckBox" Content="Thu" Margin="0,0,8,8" />
                    <CheckBox x:Name="FridayCheckBox" Content="Fri" Margin="0,0,8,8" />
                    <CheckBox x:Name="SaturdayCheckBox" Content="Sat" Margin="0,0,8,8" />
                    <CheckBox x:Name="SundayCheckBox" Content="Sun" Margin="0,0,8,8" />
                </UniformGrid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ScheduleStartLabel" Text="Start time" FontWeight="SemiBold" />
                        <TextBox x:Name="StartTimeTextBox"
                                 Style="{StaticResource SearchBox}"
                                 Margin="0,6,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ScheduleStartLabel}"
                                 AutomationProperties.HelpText="24-hour local time, for example 09:30."
                                 ToolTip="24-hour local time, for example 09:30" />
                        <TextBlock Text="24-hour local time (HH:mm)"
                                   Margin="0,4,0,0"
                                   FontSize="{DynamicResource FontSize11}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ScheduleDurationLabel" Text="Duration" FontWeight="SemiBold" />
                        <TextBox x:Name="DurationTextBox"
                                 Style="{StaticResource SearchBox}"
                                 Margin="0,6,0,0"
                                 AutomationProperties.LabeledBy="{Binding ElementName=ScheduleDurationLabel}"
                                 AutomationProperties.HelpText="Enter a duration from 5 to 720 minutes."
                                 ToolTip="5 to 720 minutes" />
                        <TextBlock Text="5–720 minutes"
                                   Margin="0,4,0,0"
                                   FontSize="{DynamicResource FontSize11}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Border Margin="0,14,0,0"
                        Padding="10"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        CornerRadius="8">
                    <TextBlock Text="Schedules use your Windows local time. If STOW opens during an unconsumed schedule window, it can start that Focus session then. Manual Focus takes priority over overlapping schedules."
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSize11}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Cancel"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Create schedule"
                            Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
