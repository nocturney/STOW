<UserControl x:Class="STOW.App.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}"
                    BorderBrush="{DynamicResource AccentBlueBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Find your focus" FontSize="{DynamicResource FontSize20}" FontWeight="SemiBold" />
                            <Border x:Name="SessionStatusChip" Style="{StaticResource StatusChip}"
                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SessionStatusText"
                                           Text="Inactive"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Temporarily stow distractions without changing your permanent app setup."
                                   Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="FocusActionButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                            Content="Start Focus" VerticalAlignment="Center" Click="FocusAction_Click" />
                </Grid>
            </Border>

            <Border x:Name="FocusStatusBanner" Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="FocusStatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <TextBlock Text="Quick setup" Style="{StaticResource SectionTitle}" Margin="0,2,0,10" />
            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                    <StackPanel>
                        <TextBlock Text="Deep work" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBlueStrongBrush}" />
                        <TextBlock Text="Stow every enabled managed app for a blank-slate desktop."
                                   Margin="0,5,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button x:Name="DeepWorkButton" Style="{StaticResource SecondaryButton}"
                                Content="Use preset" HorizontalAlignment="Left" Click="DeepWork_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceElevatedBrush}">
                    <StackPanel>
                        <TextBlock Text="Keep all visible" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTealBrush}" />
                        <TextBlock Text="Select every managed app as visible before starting a session."
                                   Margin="0,5,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button x:Name="KeepAllButton" Style="{StaticResource SecondaryButton}"
                                Content="Use preset" HorizontalAlignment="Left" Click="KeepAll_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Saved presets" FontWeight="SemiBold" />
                        <TextBlock Text="Save the current Keep visible selection for reuse."
                                   Margin="0,5,0,10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button x:Name="SavePresetButton"
                                Style="{StaticResource SecondaryButton}"
                                Content="Save current"
                                HorizontalAlignment="Left"
                                Click="SavePreset_Click" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border x:Name="SavedPresetsCard"
                    Style="{StaticResource CardBorder}"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Saved presets" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="SavedPresetsSummaryText"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{DynamicResource FontSize12}" />
                    </Grid>
                    <TextBlock x:Name="NoSavedPresetsText"
                               Text="No saved Focus presets yet."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,2" />
                    <ItemsControl x:Name="SavedPresetsList"
                                  AutomationProperties.Name="Saved Focus presets">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}"
                                                   Margin="0,2,0,0"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Use"
                                                Tag="{Binding Id}"
                                                IsEnabled="{Binding CanUse}"
                                                Margin="0,0,8,0"
                                                Click="UsePreset_Click" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Delete"
                                                Tag="{Binding Id}"
                                                Click="DeletePreset_Click" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Apps during Focus" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="ManagedAppsSummaryText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize12}" />
                        </Grid>
                        <TextBlock x:Name="NoManagedAppsText"
                                   Text="No enabled managed apps are available. Add and enable apps from Apps first."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="Collapsed" Margin="0,4,0,4" />
                        <ItemsControl x:Name="FocusAppsList"
                                      AutomationProperties.Name="Apps during Focus">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProcessName}" FontSize="{DynamicResource FontSize11}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Content="Keep visible"
                                                  Tag="{Binding Key}"
                                                  IsChecked="{Binding KeepVisible, Mode=OneWay}"
                                                  IsEnabled="{Binding CanEdit}"
                                                  Click="KeepVisible_Click"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Session" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stowed by Focus" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="StowedCountText" Grid.Column="1" Text="0" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kept visible" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="VisibleCountText" Grid.Column="1" Text="0" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Schedule" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SchedulesSummaryText"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{DynamicResource FontSize12}" />
                            </Grid>
                            <TextBlock x:Name="ScheduleStatusText"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="NoSchedulesText"
                                       Text="No Focus schedules yet."
                                       Margin="0,2,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl x:Name="ScheduleList"
                                          AutomationProperties.Name="Focus schedules">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,9,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <CheckBox Grid.Column="1"
                                                              Content="On"
                                                              Tag="{Binding Id}"
                                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                                              IsEnabled="{Binding CanManage}"
                                                              Click="ScheduleEnabled_Click"
                                                              Margin="8,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding Details}"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Status}"
                                                           Margin="0,2,0,7"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FontSize11}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Content="Edit"
                                                            AutomationProperties.Name="Edit Focus schedule"
                                                            Tag="{Binding Id}"
                                                            IsEnabled="{Binding CanManage}"
                                                            Margin="0,0,6,0"
                                                            Click="EditSchedule_Click" />
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Content="Delete"
                                                            AutomationProperties.Name="Delete Focus schedule"
                                                            Tag="{Binding Id}"
                                                            IsEnabled="{Binding CanManage}"
                                                            Click="DeleteSchedule_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddScheduleButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Add schedule"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Click="AddSchedule_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
