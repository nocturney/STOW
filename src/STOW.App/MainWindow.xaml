<Window x:Class="STOW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="STOW"
        Width="1440" Height="860"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource CanvasBrush}"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource ShellBackdropBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="3"
                  IsHitTestVisible="False"
                  ClipToBounds="True">
                <Ellipse Width="640"
                         Height="430"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-170,-170,0"
                         Fill="{DynamicResource ShellAmbientBlueBrush}" />
                <Ellipse Width="500"
                         Height="340"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="160,0,0,-170"
                         Fill="{DynamicResource ShellAmbientTealBrush}" />
            </Grid>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    CornerRadius="12,0,0,12">
                <Grid Margin="14,0,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="118" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="10,22,8,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="56" Height="56"
                               Source="/STOW;component/Assets/STOW.png"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Focusable="False" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="5,0,0,0">
                            <TextBlock Text="STOW"
                                       FontFamily="{DynamicResource StowDisplayFont}"
                                       FontSize="{DynamicResource FontSize26}"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="AppsNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Apps"
                                Tag="Apps"
                                Click="Navigate_Click"
                                Background="{DynamicResource SelectionBrush}"
                                Foreground="{DynamicResource SelectionForegroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" />
                                <AccessText Text="_Apps" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RulesNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Rules"
                                Tag="Rules"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M3,5 H17 V18 H3 Z M3,9 H17 M7,2 V7 M13,2 V7" />
                                <AccessText Text="_Rules" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="FocusNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Focus"
                                Tag="Focus"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M10,2 A8,8 0 1 1 9.99,2 M10,6 A4,4 0 1 1 9.99,6 M10,9 A1,1 0 1 1 9.99,9" />
                                <AccessText Text="_Focus" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="InsightsNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Insights"
                                Tag="Insights"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M3,18 V12 H6 V18 M8.5,18 V8 H11.5 V18 M14,18 V4 H17 V18" />
                                <AccessText Text="_Insights" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton"
                                Style="{StaticResource NavButton}"
                                AutomationProperties.Name="Settings"
                                Tag="Settings"
                                Click="Navigate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIconPath}"
                                      Data="M10,6 A4,4 0 1 1 9.99,6 M10,1 V4 M10,16 V19 M1,10 H4 M16,10 H19 M3.6,3.6 L5.7,5.7 M14.3,14.3 L16.4,16.4 M16.4,3.6 L14.3,5.7 M5.7,14.3 L3.6,16.4" />
                                <AccessText Text="_Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="14,0,10,14">
                        <TextBlock Text="☾"
                                   FontSize="{DynamicResource FontSize22}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Stay focused."
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="You've got this."
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button x:Name="AboutNavButton"
                            Grid.Row="4"
                            Style="{StaticResource NavButton}"
                            AutomationProperties.Name="About STOW"
                            Tag="About"
                            Click="Navigate_Click"
                            Margin="8,2,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIconPath}"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 M10,9 V15 M10,6.5 V6.6" />
                            <AccessText Text="A_bout" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ShellCaptionButton}"
                                AutomationProperties.Name="Minimize"
                                Click="Minimize_Click">
                            <Path Width="10" Height="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Data="M0,0 H10" />
                        </Button>
                        <Button Style="{StaticResource ShellCaptionButton}"
                                AutomationProperties.Name="Maximize or restore"
                                Click="MaximizeRestore_Click">
                            <Path Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                        </Button>
                        <Button Style="{StaticResource ShellCloseButton}"
                                AutomationProperties.Name="Close"
                                Click="CloseButton_Click">
                            <Path Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M0,0 L10,10 M10,0 L0,10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="28,5,24,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ShellSearchBox"
                             Style="{StaticResource SearchBox}"
                             Tag="Search apps, rules, or settings..."
                             AutomationProperties.Name="Search STOW"
                             Width="480"
                             MaxWidth="520"
                             HorizontalAlignment="Left"
                             TextChanged="ShellSearchBox_TextChanged"
                             KeyDown="ShellSearchBox_KeyDown" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}"
                                Tag="Focus"
                                Click="Navigate_Click"
                                AutomationProperties.Name="Open Focus mode"
                                MinWidth="144"
                                MinHeight="40"
                                Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16"
                                      Margin="0,0,8,0"
                                      Stroke="{DynamicResource AccentTealBrush}"
                                      StrokeThickness="1.7"
                                      Stretch="Uniform"
                                      Data="M2,9 C4,3 10,1 14,2 C14,8 11,13 5,14 M3,13 C6,10 9,8 13,6" />
                                <TextBlock Text="Focus mode"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2"
                      Margin="28,8,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PageIconBadge"
                                Width="46"
                                Height="46"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBlueSoftBrush}"
                                BorderBrush="{DynamicResource AccentBlueBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="Collapsed">
                            <Path x:Name="PageIconPath"
                                  Width="27"
                                  Height="27"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBlueStrongBrush}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 M10,6 A4,4 0 1 1 9.99,6 M10,9 A1,1 0 1 1 9.99,9" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PageTitleText"
                                       Text="Apps"
                                       Style="{StaticResource PageTitle}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="PageSubtitleText"
                                       Text="Keep what matters in view. Stow the rest."
                                       Style="{StaticResource PageSubtitle}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Margin="20,0,0,2">
                        <Rectangle Width="52"
                                   Height="1"
                                   Fill="{DynamicResource ControlBorderBrush}"
                                   Margin="0,0,16,6" />
                        <TextBlock Text="F O C U S   L I V E S   H E R E"
                                   FontSize="{DynamicResource FontSize11}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ContentControl x:Name="PageHost"
                                Grid.Row="4"
                                Margin="28,0,30,28" />
            </Grid>
        </Grid>
    </Border>
</Window>