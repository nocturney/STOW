<UserControl x:Class="STOW.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Private by design" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Insights are calculated from local STOW activity and stay on this PC."
                                   Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusChip}" VerticalAlignment="Center">
                        <TextBlock Text="Local only" Foreground="{DynamicResource AccentTealBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="InsightsStatusBanner" Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="InsightsStatusText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Stows · last 7 days" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StowsCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Restores · last 7 days" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="RestoresCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Focus sessions · last 7 days" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="FocusCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border x:Name="EmptyHistoryCard" Style="{StaticResource CardBorder}">
                <StackPanel HorizontalAlignment="Center" Margin="20,34">
                    <TextBlock Text="No local history yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Once STOW stows, restores, or runs Focus sessions, useful patterns will appear here."
                               Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="No telemetry or cloud account is required."
                               Margin="0,5,0,0" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="HistoryContent" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Most stowed app" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="MostStowedAppText" Text="—"
                                       Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="MostStowedCountText" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="History" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="HistoryRangeText" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Stored only in %APPDATA%STOWactivity.jsonl"
                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Recent activity" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="RecentCountText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        </Grid>
                        <ItemsControl x:Name="RecentActivityList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
