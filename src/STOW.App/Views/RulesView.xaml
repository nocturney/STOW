<UserControl x:Class="STOW.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.62*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.96*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Visibility="Collapsed"
                     TextChanged="SearchBox_TextChanged" />

            <StackPanel Grid.Column="0">
                <Border x:Name="RulesStatusBanner"
                        Style="{StaticResource CardBorder}"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="RulesStatusText"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="0"
                        MinHeight="470">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Automation rules"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Control what STOW does, when it does it, and which apps are affected."
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="NewRuleButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="+  Add rule"
                                    MinHeight="40"
                                    VerticalAlignment="Center"
                                    Click="NewRule_Click" />
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="18,0,18,14">
                            <Button x:Name="AllRulesFilterButton"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="All rules"
                                    Tag="All"
                                    Margin="0,0,8,0"
                                    Click="RulesFilter_Click" />
                            <Button x:Name="AppRulesFilterButton"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="App rules"
                                    Tag="Minimize"
                                    Margin="0,0,8,0"
                                    Click="RulesFilter_Click" />
                            <Button x:Name="FocusRulesFilterButton"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="Focus rules"
                                    Tag="Focus"
                                    Margin="0,0,8,0"
                                    Click="RulesFilter_Click" />
                            <Button x:Name="StartupRulesFilterButton"
                                    Style="{StaticResource FilterPillButton}"
                                    Content="Startup rules"
                                    Tag="Startup"
                                    Click="RulesFilter_Click"
                                    ToolTip="Rules applied when a managed app process is first observed." />
                        </StackPanel>

                        <Grid Grid.Row="2"
                              Margin="18,0,18,0"
                              Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rule name"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="When"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="Do"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="Status"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Border x:Name="EmptyRulesCard"
                                    Margin="18,8,18,18"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="10"
                                    Padding="28"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="46" Height="46"
                                            CornerRadius="10"
                                            Background="{DynamicResource SelectionBrush}"
                                            Margin="0,0,0,12">
                                        <Path Width="24" Height="24"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBlueStrongBrush}"
                                              StrokeThickness="1.7"
                                              Data="M3,5 H17 V18 H3 Z M3,9 H17 M7,2 V7 M13,2 V7" />
                                    </Border>
                                    <TextBlock x:Name="EmptyRulesTitleText"
                                               Text="No rules yet"
                                               FontSize="{DynamicResource FontSize17}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="EmptyRulesBodyText"
                                               Text="Create an app, Focus or Startup rule for a managed application."
                                               Margin="0,6,0,12"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               MaxWidth="460" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Create your first rule"
                                            Click="NewRule_Click" />
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="RulesList"
                                     AutomationProperties.Name="Saved rules"
                                     Margin="10,0,10,10"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     SelectionChanged="RulesList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{StaticResource StowFocusVisual}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowBorder}"
                                                Padding="8,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Type}"
                                                               Margin="0,2,0,0"
                                                               FontSize="{DynamicResource FontSize11}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WhenText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ActionText}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <Border Grid.Column="3"
                                                        Style="{StaticResource StatusChip}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                                                            <Setter Property="Fill" Value="{DynamicResource AccentTealBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontSize="{DynamicResource FontSize11}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorder}"
                    Padding="0"
                    MinHeight="470"
                    VerticalAlignment="Top">
                <Grid>
                    <StackPanel x:Name="EditorPlaceholder"
                                VerticalAlignment="Top"
                                Margin="18,18,18,20">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42"
                                    CornerRadius="10"
                                    Background="{DynamicResource SelectionBrush}"
                                    HorizontalAlignment="Left">
                                <Path Width="22" Height="22"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBlueStrongBrush}"
                                      StrokeThickness="1.7"
                                      Data="M10,2 A8,8 0 1 1 9.99,2 M10,6 A4,4 0 1 1 9.99,6 M10,9 A1,1 0 1 1 9.99,9" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Rule details"
                                           FontSize="{DynamicResource FontSize18}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Select a saved rule to edit it."
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,14" />

                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Create a rule"
                                           Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Every rule connects an app, a condition and an action."
                                           Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource AccentBlueSoftBrush}">
                                        <TextBlock Text="1"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBlueStrongBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Choose a managed app"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Pick the app this automation belongs to."
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource AccentTealSoftBrush}">
                                        <TextBlock Text="2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTealBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Choose when it runs"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Minimize, Focus start or app startup."
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource AccentAmberSoftBrush}">
                                        <TextBlock Text="3"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentAmberBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Choose what STOW does"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Stow the app or keep it visible."
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel Margin="-4,0,-4,14">
                            <Border Margin="4"
                                    Padding="10,7"
                                    Background="{DynamicResource AccentBlueSoftBrush}"
                                    CornerRadius="8">
                                <TextBlock Text="Minimize"
                                           FontSize="{DynamicResource FontSize11}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Margin="4"
                                    Padding="10,7"
                                    Background="{DynamicResource AccentTealSoftBrush}"
                                    CornerRadius="8">
                                <TextBlock Text="Focus"
                                           FontSize="{DynamicResource FontSize11}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Margin="4"
                                    Padding="10,7"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock Text="Startup"
                                           FontSize="{DynamicResource FontSize11}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </WrapPanel>

                        <Button Style="{StaticResource PrimaryButton}"
                                Content="+  Create rule"
                                HorizontalAlignment="Stretch"
                                Click="NewRule_Click" />
                    </StackPanel>

                    <StackPanel x:Name="EditorPanel"
                                Visibility="Collapsed">
                        <Grid Margin="18,16,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="EditorTitleText"
                                           Text="Rule"
                                           FontSize="{DynamicResource FontSize20}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Details, condition, action and priority"
                                           Margin="0,3,0,0"
                                           FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="EnabledCheckBox"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      Content="Enabled"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderBrush}"
                                Margin="0,0,0,14" />

                        <StackPanel Margin="18,0,18,16">
                            <TextBlock x:Name="RuleNameLabel"
                                       Text="Rule name"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="RuleNameTextBox"
                                     AutomationProperties.LabeledBy="{Binding ElementName=RuleNameLabel}"
                                     Margin="0,6,0,14"
                                     Padding="12,8"
                                     MinHeight="42"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1" />

                            <TextBlock x:Name="RuleAppLabel"
                                       Text="App"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox x:Name="AppComboBox"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.LabeledBy="{Binding ElementName=RuleAppLabel}"
                                      Margin="0,6,0,14" />

                            <TextBlock x:Name="RuleTriggerLabel"
                                       Text="When"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox x:Name="TriggerComboBox"
                                      AutomationProperties.LabeledBy="{Binding ElementName=RuleTriggerLabel}"
                                      SelectedIndex="0"
                                      Margin="0,6,0,14">
                                <ComboBoxItem Content="The app is minimized" />
                                <ComboBoxItem Content="Focus starts" />
                                <ComboBoxItem Content="The app starts" />
                            </ComboBox>

                            <TextBlock x:Name="RuleActionLabel"
                                       Text="Do"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox x:Name="ActionComboBox"
                                      AutomationProperties.LabeledBy="{Binding ElementName=RuleActionLabel}"
                                      SelectedIndex="0"
                                      Margin="0,6,0,14">
                                <ComboBoxItem Content="Stow in system tray" />
                                <ComboBoxItem Content="Keep visible on taskbar" />
                            </ComboBox>

                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="RulePriorityLabel"
                                           Text="Priority"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="PriorityValueText"
                                           HorizontalAlignment="Right"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="PrioritySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="50"
                                    AutomationProperties.LabeledBy="{Binding ElementName=RulePriorityLabel}"
                                    AutomationProperties.HelpText="Higher-priority matching rules win."
                                    ValueChanged="PrioritySlider_ValueChanged"
                                    Margin="0,4,0,20" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DeleteRuleButton"
                                        Style="{StaticResource DangerButton}"
                                        Content="Delete"
                                        Click="DeleteRule_Click"
                                        Margin="0,0,8,0" />
                                <Button x:Name="DuplicateRuleButton"
                                        Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Duplicate"
                                        Click="DuplicateRule_Click"
                                        Margin="0,0,8,0" />
                                <Button x:Name="SaveRuleButton"
                                        Grid.Column="3"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Save changes"
                                        Click="SaveRule_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>