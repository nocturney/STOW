<UserControl x:Class="STOW.App.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Private by design" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Insights are calculated from local STOW activity and stay on this PC."
                                   Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusChip}" VerticalAlignment="Center">
                        <TextBlock Text="Local only" Foreground="{DynamicResource AccentTealBrush}" />
                    </Border>
                </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,14">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Apps stowed" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Restores" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel><TextBlock Text="Focus sessions" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel HorizontalAlignment="Center" Margin="20,34">
                    <TextBlock Text="No local history yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Once STOW has been managing apps for a while, useful patterns will appear here."
                               Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="No telemetry or cloud account is required."
                               Margin="0,5,0,0" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
