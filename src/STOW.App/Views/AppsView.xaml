<UserControl x:Class="STOW.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                         Tag="Search apps..."
                         MaxWidth="560" HorizontalAlignment="Left" Width="500"
                         AutomationProperties.Name="Search apps"
                         AutomationProperties.HelpText="Filter managed and available applications."
                         TextChanged="SearchBox_TextChanged" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add app"
                        IsEnabled="False" ToolTip="Use Add on a running app below."
                        Margin="12,0,0,0" />
            </Grid>

            <Border x:Name="EngineStatusBanner" Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,18" Visibility="Collapsed">
                <TextBlock x:Name="EngineStatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Margin="18,16,18,8">
                            <TextBlock Text="Managed apps" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="ManagedSummaryText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize12}" />
                        </Grid>
                        <TextBlock Text="These apps are hidden or limited on your desktop."
                                   Margin="18,0,18,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Border x:Name="NoManagedApps" Margin="18,0,18,18"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="9" Padding="18" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="No managed apps yet" FontWeight="SemiBold" />
                                <TextBlock Text="Add a running desktop app to let STOW manage it."
                                           Margin="0,5,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>                        <ItemsControl x:Name="ManagedAppsList"
                                      AutomationProperties.Name="Managed apps"
                                      Margin="10,0,10,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}"
                                                           Width="24" Height="24"
                                                           Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               Margin="0,2,0,0"
                                                               FontSize="{DynamicResource FontSize11}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Column="1" Style="{StaticResource StatusChip}"
                                                    Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="{DynamicResource FontSize11}" />
                                            </Border>                                            <CheckBox Grid.Column="2"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      Tag="{Binding Key}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      IsEnabled="{Binding CanManage}"
                                                      Click="ManagedEnabled_Click"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="↗"
                                                    AutomationProperties.Name="Show app now"
                                                    ToolTip="Show app now"
                                                    Width="44"
                                                    Tag="{Binding Key}"
                                                    IsEnabled="{Binding CanRestore}"
                                                    Click="Restore_Click"
                                                    Margin="0,0,6,0"
                                                    Padding="0" />                                            <Button Grid.Column="4"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="×"
                                                    AutomationProperties.Name="Remove managed app"
                                                    ToolTip="Remove from managed apps"
                                                    Width="44"
                                                    Tag="{Binding Key}"
                                                    IsEnabled="{Binding CanManage}"
                                                    Click="Remove_Click"
                                                    Padding="0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Margin="18,16,18,8">
                            <TextBlock Text="Available apps" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="AvailableSummaryText" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{DynamicResource FontSize12}" />
                        </Grid>
                        <TextBlock Text="Apps not currently managed by STOW."
                                   Margin="18,0,18,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />                        <Border x:Name="NoAvailableApps"
                                Margin="18,0,18,18"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="9"
                                Padding="18"
                                Visibility="Collapsed">
                            <TextBlock Text="No desktop apps match this search."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>                        <ItemsControl x:Name="AvailableAppsList"
                                      AutomationProperties.Name="Available apps"
                                      Margin="10,0,10,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}"
                                                           Width="24" Height="24"
                                                           Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ProcessName}"
                                                               Margin="0,2,0,0"
                                                               FontSize="{DynamicResource FontSize11}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="Add"
                                                    Tag="{Binding Key}"
                                                    IsEnabled="{Binding CanAdd}"
                                                    Click="AddApp_Click"
                                                    VerticalAlignment="Center"
                                                    Padding="12,4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
