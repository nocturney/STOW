<UserControl x:Class="STOW.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border x:Name="SettingsStatusBanner" Style="{StaticResource CardBorder}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="SettingsStatusText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>

            <WrapPanel ItemWidth="470">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Choose what happens when you close the STOW window."
                                   Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="KeepRunningCheckBox" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Keep STOW running in the tray"
                              VerticalAlignment="Center"
                              Click="KeepRunning_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Theme" Margin="0,14,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            HorizontalAlignment="Left"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LightThemeRadio"
                                         Style="{StaticResource ThemeSegmentRadio}"
                                         GroupName="Theme"
                                         Content="Light"
                                         Tag="Light"
                                         Click="Theme_Click" />
                            <RadioButton x:Name="DarkThemeRadio"
                                         Style="{StaticResource ThemeSegmentRadio}"
                                         GroupName="Theme"
                                         Content="Dark"
                                         Tag="Dark"
                                         Click="Theme_Click" />
                            <RadioButton x:Name="SystemThemeRadio"
                                         Style="{StaticResource ThemeSegmentRadio}"
                                         GroupName="Theme"
                                         Content="System"
                                         Tag="System"
                                         Click="Theme_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Accessibility" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Keyboard navigation and screen-reader support are always enabled. Windows contrast themes are followed automatically."
                               Margin="0,5,0,14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TextSizeLabel"
                                       Text="Text size"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Increase STOW text without changing Windows display scaling."
                                       Margin="0,4,20,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="TextScaleComboBox" Grid.Column="1"
                                  MinHeight="44"
                                  AutomationProperties.LabeledBy="{Binding ElementName=TextSizeLabel}"
                                  SelectionChanged="TextScale_SelectionChanged">
                            <ComboBoxItem Tag="100" Content="Standard (100%)" />
                            <ComboBoxItem Tag="125" Content="Large (125%)" />
                            <ComboBoxItem Tag="150" Content="Extra large (150%)" />
                            <ComboBoxItem Tag="200" Content="Maximum (200%)" />
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="EnhancedContrastCheckBox"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Increase contrast in STOW"
                              Margin="0,2,0,8"
                              Checked="Accessibility_Changed"
                              Unchecked="Accessibility_Changed" />
                    <CheckBox x:Name="UseSystemFontCheckBox"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Use the Windows UI font"
                              Margin="0,0,0,4"
                              Checked="Accessibility_Changed"
                              Unchecked="Accessibility_Changed" />
                    <TextBlock x:Name="SystemContrastStatusText"
                               Text="Windows contrast theme is active. STOW is following it."
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Start STOW quietly with Windows when at least one managed app is enabled."
                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Start STOW with Windows"
                              VerticalAlignment="Center"
                              Click="StartWithWindows_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Show local Windows tray notifications when scheduled Focus sessions start or end."
                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="NotificationsCheckBox"
                              Grid.Column="1"
                              Style="{StaticResource ToggleSwitch}"
                              Content="Scheduled Focus notifications"
                              VerticalAlignment="Center"
                              Checked="Notifications_Changed"
                              Unchecked="Notifications_Changed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Focus behavior" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Choose what STOW does with apps hidden by Focus when the session ends."
                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="FocusEndComboBox" Grid.Column="1"
                              MinHeight="44" VerticalAlignment="Center"
                              AutomationProperties.Name="Focus end behavior"
                              SelectionChanged="FocusEnd_SelectionChanged">
                        <ComboBoxItem Tag="RestorePreviousDesktop" Content="Restore previous desktop" />
                        <ComboBoxItem Tag="KeepAppsStowed" Content="Keep Focus apps stowed" />
                    </ComboBox>
                </Grid>
            </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
